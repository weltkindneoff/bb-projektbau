{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "bg", "name": "Hintergrund", "color": "var(--bb-bg)" },
				{ "slug": "surface", "name": "Fläche", "color": "var(--bb-surface)" },
				{ "slug": "text", "name": "Text", "color": "var(--bb-text)" },
				{ "slug": "muted", "name": "Gedämpft", "color": "var(--bb-muted)" },
				{ "slug": "line", "name": "Linie", "color": "var(--bb-line)" },
				{ "slug": "navy", "name": "Navy", "color": "var(--bb-navy)" },
				{ "slug": "teal", "name": "Petrol", "color": "var(--bb-teal)" },
				{ "slug": "accent", "name": "Akzent Gold", "color": "var(--bb-accent)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ] },
						{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-ext-wght-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Groß", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Sehr groß", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Riesig", "size": "3.25rem", "fluid": { "min": "2.125rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1200px" }
	},
	"styles": {
		"color": { "background": "var(--bb-bg)", "text": "var(--bb-text)" },
		"spacing": { "padding": { "left": "clamp(1.25rem, 4vw, 2.5rem)", "right": "clamp(1.25rem, 4vw, 2.5rem)" }, "blockGap": "1.25rem" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"elements": {
			"heading": { "typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }, "color": { "text": "var(--bb-heading)" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": { "color": { "text": "var(--bb-link)" }, ":hover": { "color": { "text": "var(--bb-text)" } } },
			"button": {
				"color": { "background": "var(--bb-accent)", "text": "#13254B" },
				"typography": { "fontWeight": "650", "fontSize": "1rem" },
				"border": { "radius": "10px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.4rem", "right": "1.4rem" } },
				":hover": { "color": { "background": "var(--bb-accent-hover)" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kopfzeile", "area": "header" },
		{ "name": "footer", "title": "Fußzeile", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-legal", "title": "Rechtliches", "postTypes": [ "page" ] },
		{ "name": "page-landing", "title": "Landingpage (volle Breite)", "postTypes": [ "page" ] }
	]
}
